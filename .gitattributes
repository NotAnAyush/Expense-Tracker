# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure code & config files use LF
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf

# Force specific binary file formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
